# Quantum Text Adventure - Environment Configuration
# Copy this file to .env and configure as needed

# Player settings
DEFAULT_PLAYER_NAME=Traveler

# Game settings
ENABLE_DEBUG_MODE=false
MAX_PARALLEL_TIMELINES=4
AUTO_SAVE_ENABLED=true

# Display settings
CLEAR_SCREEN_ON_START=true
USE_UNICODE_BORDERS=true

# Save/Load settings
SAVE_DIRECTORY=saves
